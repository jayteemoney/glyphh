# ── Chain ─────────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.unichain.org
CHAIN_ID=1301

# ── Deployed contract addresses (fill from docs/DEPLOYMENT.md) ────────────────
REGISTRY_ADDRESS=
HOOK_ADDRESS=
# Canonical v4 PoolManager (Unichain Sepolia: 0x00B036B58a818B1BC34d502D3fE730Db729e62AC)
POOL_MANAGER_ADDRESS=

# ── Pool identity (the keeper filters Swap events to this pool) ───────────────
CURRENCY0=
CURRENCY1=
TICK_SPACING=60

# ── Attestor key (throwaway key — never reuse for real funds) ─────────────────
ATTESTOR_PRIVATE_KEY=

# ── Detector tuning ───────────────────────────────────────────────────────────
# How many blocks back to scan for swap history (default 7 days ~ 50400 blocks at 12s)
LOOKBACK_BLOCKS=50400
# Deadline window for signed attestations in seconds (default 10 min)
DEADLINE_SECONDS=600

# ── Brevis (optional) ─────────────────────────────────────────────────────────
# When set, hist_tox_score_7d uses the ZK-proven value from GlyphHistoryConsumer
# instead of the RPC event scan.
BREVIS_CONSUMER_ADDRESS=

# ── Attestor safety ───────────────────────────────────────────────────────────
# Min seconds between signatures (rate-limit) and where the replay-guard state lives.
MIN_SIGN_INTERVAL=1.0
DETECTOR_STATE=.detector_state.json

# ── Keeper loop (python -m detector.keeper) ───────────────────────────────────
# Poll cadence and how many past blocks to scan at startup.
KEEPER_POLL_SECONDS=2
KEEPER_BACKFILL_BLOCKS=10
# Sliding window a swap stays relevant for, and the burst-pair gap (seconds).
KEEPER_WINDOW_SECONDS=600
KEEPER_BURST_GAP_SECONDS=30
# Hard rule: this many swaps, this fraction same-direction → score floor below.
KEEPER_BURST_MIN_SWAPS=4
KEEPER_BURST_DIR_RATIO=0.8
KEEPER_BURST_FLOOR_SCORE=8000
# Only submit attestations at/above this score, and only if the new score
# beats the current on-chain score by at least this delta.
KEEPER_SUBMIT_THRESHOLD=3000
KEEPER_MIN_SCORE_DELTA=500
# Comma-separated wallets to never score (the attestor wallet is always ignored).
KEEPER_IGNORE_WALLETS=
