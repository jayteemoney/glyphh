# ── Chain ─────────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.unichain.org
CHAIN_ID=1301

# ── Deployed contract addresses (fill after forge deploy) ─────────────────────
REGISTRY_ADDRESS=
HOOK_ADDRESS=

# ── Attestor key (throwaway key — never reuse for real funds) ─────────────────
ATTESTOR_PRIVATE_KEY=

# ── Detector tuning ───────────────────────────────────────────────────────────
# How many blocks back to scan for swap history (default 7 days ~ 50400 blocks at 12s)
LOOKBACK_BLOCKS=50400
# Deadline window for signed attestations in seconds (default 10 min)
DEADLINE_SECONDS=600
