# ── Chain ─────────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.unichain.org
CHAIN_ID=1301

# ── Bot keys (throwaway testnet keys only — never reuse for real funds) ────────
# The attacker and the clean trader use separate keys so their scores diverge.
ATTACKER_PRIVATE_KEY=
CLEAN_PRIVATE_KEY=

# ── Glyph deployment (fill after `forge script DeployGlyph`) ──────────────────
REGISTRY_ADDRESS=
HOOK_ADDRESS=

# ── Pool wiring (from your LocalDemo / pool-init script) ──────────────────────
# PoolSwapTest router (v4 test swap router) — the bots route swaps through this.
SWAP_ROUTER_ADDRESS=
# The two pool currencies (token0 < token1 by address). Use 0x000...0 for native ETH.
CURRENCY0=
CURRENCY1=
TICK_SPACING=60

# ── Demo tuning ───────────────────────────────────────────────────────────────
# Per-swap input amount (in token0 base units) and burst/pacing counts.
SWAP_AMOUNT=1000000000000000
ATTACKER_BURST=6
CLEAN_SWAPS=4
CLEAN_INTERVAL_MS=8000
